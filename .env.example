# ─── Banco de dados (Postgres) ───────────────────────────────────────────────
# Local: Postgres em localhost.
# Vercel/produção: use um Postgres gerenciado (Neon, Supabase, Vercel Postgres)
# e, por ser serverless, prefira a string COM POOLER para não esgotar conexões.
#   ex. Neon:     postgresql://USER:PASS@HOST/db?sslmode=require&pgbouncer=true&connection_limit=1
#   ex. Supabase: use a porta 6543 (pooler) em vez da 5432
DATABASE_URL="postgresql://user:password@localhost:5432/conciliacao_dev"

# ─── Conexão direta (Prisma migrate) ─────────────────────────────────────────
# Supabase: o pooler (6543, pgbouncer) NÃO suporta DDL transacional usado pelas
# migrations. Use a conexão DIRETA na porta 5432 só para migrate/generate.
#   ex. Supabase: postgresql://USER:PASS@HOST.supabase.com:5432/postgres
DIRECT_URL="postgresql://user:password@localhost:5432/conciliacao_dev"

# ─── LLM (análise de inconsistências do Book Digital) ─────────────────────────
# Provedor padrão: Anthropic (Claude). Alternativa: "gemini".
# Placeholders vazios — NUNCA commitar chave real.
LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Usado apenas quando LLM_PROVIDER=gemini.
GEMINI_API_KEY=""
# Opcional: sobrescreve o modelo Gemini (padrão: gemini-2.0-flash).
GEMINI_MODEL=""

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Gere um segredo real com:  openssl rand -base64 32
#   (ou: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
# Local: http://localhost:3000  |  Produção: a URL pública do Vercel (https://...)
NEXTAUTH_URL="http://localhost:3000"

# ─── Seed do usuário admin (prisma db seed) ──────────────────────────────────
# Local: pode omitir — usa o padrão admin@ncc.com.br / conciliacao123.
# Produção: OBRIGATÓRIO definir ADMIN_PASSWORD (o seed falha se NODE_ENV=production
# e ADMIN_PASSWORD estiver vazio).
ADMIN_EMAIL="admin@ncc.com.br"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# ─── Opcional ────────────────────────────────────────────────────────────────
# Não utilizado pela aplicação atualmente (sem fila/Bull). Pode omitir no deploy.
# REDIS_URL="redis://localhost:6379"
